# Servera konfigurācija
PORT=3000
NODE_ENV=development

# Datubāzes konfigurācija
# Iestatiet DB_DRIVER=mysql MySQL datubāzei (pēc noklusējuma specifikācijā),
# vai DB_DRIVER=sqlite tūlītējai lokālai izstrādei bez MySQL servera
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=monet_db

# SQLite faila ceļš (tiek izmantots, ja DB_DRIVER=sqlite vai kā rezerves variants, ja MySQL nav pieejams)
DB_SQLITE_PATH=./data/monet.sqlite

# JWT autentifikācija
JWT_SECRET=super_secret_monet_coworking_token_jwt_2026
JWT_EXPIRES_IN=7d
